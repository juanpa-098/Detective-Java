import java.util.Scanner;

class Espia {
    String nombreClave;
    int nodosIdentificados;
    int conexionesConfirmadas;

    public Espia(String nombreClave, int nodosIdentificados, int conexionesConfirmadas) {
        this.nombreClave = nombreClave;
        this.nodosIdentificados = nodosIdentificados;
        this.conexionesConfirmadas = conexionesConfirmadas;
    }

    public void informarRedHidden() {
        System.out.println("El analista " + nombreClave + " identificó " + nodosIdentificados +
         " nodos y " + conexionesConfirmadas +
           " conexiones en la red HIDDEN");
    }
}

